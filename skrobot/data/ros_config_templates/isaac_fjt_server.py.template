#!/usr/bin/env python3
"""FollowJointTrajectory -> $joint_command_topic bridge for Isaac Sim.

Generated by skrobot.export.generate_fjt_server. One action server per
controller streams the interpolated trajectory into $joint_command_topic.
"""
import threading
import time

import rclpy
from rclpy.action import ActionServer, CancelResponse, GoalResponse
from rclpy.callback_groups import ReentrantCallbackGroup
from rclpy.executors import MultiThreadedExecutor
from rclpy.node import Node
from rclpy.parameter import Parameter

from control_msgs.action import FollowJointTrajectory
from sensor_msgs.msg import JointState
from trajectory_msgs.msg import JointTrajectoryPoint

NODE_NAME = $node_name
JOINT_COMMAND_TOPIC = $joint_command_topic_repr
JOINT_STATES_TOPIC = $joint_states_topic_repr
PUBLISH_HZ = $publish_hz
GOAL_TOLERANCE = $goal_tolerance
SETTLE_TIMEOUT = $settle_timeout
CONTROLLERS = $controllers


def _interp(p0, p1, t0, t1, t):
    """Linear interpolation of a joint vector between two waypoints."""
    if t1 <= t0:
        return list(p1)
    a = (t - t0) / (t1 - t0)
    return [x0 + (x1 - x0) * a for x0, x1 in zip(p0, p1)]


def _segment_velocity(p0, p1, t0, t1):
    """Constant velocity of the linear segment, sent as the drive feedforward.

    Without it the physics drive holds targetVelocity=0, so its damping term
    brakes against every intended motion and the joint sits a steady (d/k)*v
    behind the setpoint just to move. Feeding the intended velocity cancels that
    braking term instead of fighting it with position error.
    """
    if t1 <= t0:
        return [0.0] * len(p1)
    dt = t1 - t0
    return [(x1 - x0) / dt for x0, x1 in zip(p0, p1)]


class FJTServer(Node):
    def __init__(self):
        super().__init__(NODE_NAME)
        # Follow the sim /clock: trajectory timing must use the clock the sim
        # advances. The sim does not run at wall-clock rate, so timing against
        # wall time would march the setpoints ahead of the physics.
        self.set_parameters([Parameter("use_sim_time", Parameter.Type.BOOL, True)])
        self._lock = threading.Lock()
        self._targets = {}       # joint -> commanded position (published each tick)
        self._target_vels = {}   # joint -> commanded velocity (feedforward)
        self._actual = {}        # joint -> measured position (from joint_states)
        self._all_joints = [j for js in CONTROLLERS.values() for j in js]
        self._seeded = False
        self._cb = ReentrantCallbackGroup()

        self._cmd_pub = self.create_publisher(JointState, JOINT_COMMAND_TOPIC, 10)
        self.create_subscription(JointState, JOINT_STATES_TOPIC, self._on_states, 10)

        self._servers = {}
        for name, joints in CONTROLLERS.items():
            self._servers[name] = ActionServer(
                self, FollowJointTrajectory,
                "/%s/follow_joint_trajectory" % name,
                execute_callback=self._make_execute(joints),
                goal_callback=lambda _req: GoalResponse.ACCEPT,
                cancel_callback=lambda _gh: CancelResponse.ACCEPT,
                callback_group=self._cb)

        self.create_timer(1.0 / PUBLISH_HZ, self._publish_cmd,
                          callback_group=self._cb)
        self.get_logger().info(
            "%s up: %s (waiting for joint_states to seed)"
            % (NODE_NAME, ", ".join(
                "/%s/follow_joint_trajectory" % n for n in CONTROLLERS)))

    def _on_states(self, msg):
        # Seed targets from the measured pose so the first tick does not yank the
        # robot to zero before any goal arrives.
        with self._lock:
            for n, p in zip(msg.name, msg.position):
                self._actual[n] = p
            if not self._seeded and all(j in self._actual for j in self._all_joints):
                for j in self._all_joints:
                    self._targets[j] = self._actual[j]
                    self._target_vels[j] = 0.0
                self._seeded = True
                self.get_logger().info("seeded targets from joint_states; streaming")

    def _publish_cmd(self):
        with self._lock:
            if not self._seeded:
                return
            names = list(self._targets.keys())
            pos = [self._targets[n] for n in names]
            vel = [self._target_vels.get(n, 0.0) for n in names]
        msg = JointState()
        msg.header.stamp = self.get_clock().now().to_msg()
        msg.name = names
        msg.position = pos
        msg.velocity = vel
        self._cmd_pub.publish(msg)

    def _make_execute(self, owned_joints):
        def execute(goal_handle):
            traj = goal_handle.request.trajectory
            names = list(traj.joint_names)
            pts = traj.points
            result = FollowJointTrajectory.Result()
            invalid_names = [n for n in names if n not in owned_joints]
            if invalid_names:
                goal_handle.abort()
                result.error_code = FollowJointTrajectory.Result.INVALID_JOINTS
                return result
            if not pts:
                goal_handle.succeed()
                result.error_code = FollowJointTrajectory.Result.SUCCESSFUL
                return result

            times = [p.time_from_start.sec + p.time_from_start.nanosec * 1e-9
                     for p in pts]
            positions = [list(p.positions) for p in pts]
            # prepend the current commanded pose at t=0 so motion starts smoothly
            if times[0] > 1e-6:
                with self._lock:
                    start = [self._targets.get(n, self._actual.get(n, 0.0))
                             for n in names]
                times = [0.0] + times
                positions = [start] + positions

            total = times[-1]
            t_start = self.get_clock().now()
            fb = FollowJointTrajectory.Feedback()
            fb.joint_names = names
            dt = 1.0 / PUBLISH_HZ
            while rclpy.ok():
                if goal_handle.is_cancel_requested:
                    goal_handle.canceled()
                    return result
                t = (self.get_clock().now() - t_start).nanoseconds * 1e-9
                if t >= total:
                    cur = positions[-1]
                    vel = [0.0] * len(names)      # arrived: hold, no feedforward
                else:
                    i = 0
                    while i < len(times) - 1 and not (times[i] <= t < times[i + 1]):
                        i += 1
                    cur = _interp(positions[i], positions[i + 1],
                                  times[i], times[i + 1], t)
                    vel = _segment_velocity(positions[i], positions[i + 1],
                                            times[i], times[i + 1])
                with self._lock:
                    for n, p, v in zip(names, cur, vel):
                        if n in self._targets:
                            self._targets[n] = p
                            self._target_vels[n] = v
                    actual = [self._actual.get(n, 0.0) for n in names]
                dp = JointTrajectoryPoint()
                dp.positions = list(cur)
                ap = JointTrajectoryPoint()
                ap.positions = actual
                fb.desired = dp
                fb.actual = ap
                goal_handle.publish_feedback(fb)
                if t >= total:
                    break
                time.sleep(dt)

            # Hold the final target until the robot actually arrives. The physics
            # drive lags the trajectory, so returning at t=total reports "arrived"
            # while the joint is still ~GOAL_TOLERANCE away; a real
            # joint_trajectory_controller waits on goal tolerance the same way.
            # SETTLE_TIMEOUT bounds it so a joint that cannot reach its goal
            # (blocked, mistuned gain) fails loudly instead of hanging.
            settle_start = self.get_clock().now()
            worst = None
            with self._lock:
                for n in names:
                    if n in self._target_vels:
                        self._target_vels[n] = 0.0
            while rclpy.ok():
                if goal_handle.is_cancel_requested:
                    goal_handle.canceled()
                    return result
                with self._lock:
                    errs = {n: abs(self._actual.get(n, 0.0) - self._targets[n])
                            for n in names if n in self._targets}
                if not errs:
                    break
                worst_joint = max(errs, key=errs.get)
                worst = (worst_joint, errs[worst_joint])
                if worst[1] <= GOAL_TOLERANCE:
                    break
                elapsed = (self.get_clock().now() - settle_start).nanoseconds * 1e-9
                if elapsed > SETTLE_TIMEOUT:
                    self.get_logger().warn(
                        "goal tolerance not met after %.1fs: %s off by %.4f "
                        "(tol %.3f)" % (SETTLE_TIMEOUT, worst[0], worst[1],
                                        GOAL_TOLERANCE))
                    goal_handle.abort()
                    result.error_code = \
                        FollowJointTrajectory.Result.GOAL_TOLERANCE_VIOLATED
                    return result
                time.sleep(dt)

            goal_handle.succeed()
            result.error_code = FollowJointTrajectory.Result.SUCCESSFUL
            return result
        return execute


def main():
    rclpy.init()
    node = FJTServer()
    executor = MultiThreadedExecutor(num_threads=6)
    executor.add_node(node)
    try:
        executor.spin()
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == "__main__":
    main()
